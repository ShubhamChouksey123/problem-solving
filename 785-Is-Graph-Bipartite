class Solution {
    
    public boolean isBipartite(int[][] graph, int[] colors, int node, int color) {
        
        if(colors[node] != 0){
            return colors[node] == color;
        }

        colors[node] = color;
        
        for(int neighbour : graph[node]){
            if(!isBipartite(graph, colors, neighbour, -color)) {
                return false;
            }           
        }
        return true;
    }
    
    
    public boolean isBipartite(int[][] graph) {
        int n = graph.length;
        int[] colors = new int[n];   

        for(int i = 0 ; i < n ; i++){
            if(colors[i] == 0){
                if(!isBipartite(graph, colors, i, 1) ){
                    return false;
                }
            }
        }
        return true;

    }
}